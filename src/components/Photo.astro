---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Import a photo from src/assets/photos/ and pass it here. Until then a placeholder shows. */
  src?: ImageMetadata;
  alt: string;
  /** Brief for the photographer, shown on the placeholder. */
  brief: string;
  ratio?: string;
  ratioLabel?: string;
  warm?: boolean;
  class?: string;
  style?: string;
  eager?: boolean;
  sizes?: string;
}
const { src, alt, brief, ratio = '4 / 5', ratioLabel, warm, class: cls = '', style = '', eager, sizes = '(max-width: 900px) 100vw, 50vw' } = Astro.props;
---
{src ? (
  <div class={`photo ${cls}`} style={`aspect-ratio: ${ratio}; ${style}`}>
    <Image src={src} alt={alt} widths={[480, 800, 1200, 1600]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
  </div>
) : (
  <div class={`photo ${warm ? 'photo--warm' : ''} ${cls}`} role="img" aria-label={`Photo to come: ${alt}`} style={`aspect-ratio: ${ratio}; ${style}`}>
    <div class="photo__meta mono"><span>Photo · {ratioLabel ?? ratio.replace(/\s/g, '').replace('/', ':')}</span><span class="ph">Placeholder</span></div>
    <p class="photo__brief">{brief}</p>
  </div>
)}
