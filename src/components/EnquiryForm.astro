---
import Icon from './Icon.astro';
import { site, phHtml } from '../config/site';

interface Props { id?: string }
const { id = 'enquiry' } = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const replyHtml = phHtml(site.replyDays, 'X');
---
<div class="enq" data-enquiry data-key={accessKey} data-dev={import.meta.env.DEV ? '1' : ''}>
  <div class="enq__top mono"><span>Enquiry · Free chat</span><span>Table for your café</span></div>

  <form class="enq__form" action="https://api.web3forms.com/submit" method="POST" novalidate aria-label="Book a free chat" data-form>
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="New enquiry — The Second Visit website" />
    <input type="hidden" name="from_name" value="The Second Visit website" />
    <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="field-group">
      <label class="field-label" for={`${id}-name`}>Your name</label>
      <input class="field" id={`${id}-name`} name="name" type="text" autocomplete="name" required aria-describedby={`${id}-name-err`} />
      <p class="field-error" id={`${id}-name-err`} data-err="name" hidden><Icon name="alert" size={16} stroke={2} /><span></span></p>
    </div>

    <div class="field-group">
      <label class="field-label" for={`${id}-phone`}>Phone or WhatsApp number</label>
      <input class="field" id={`${id}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel" required aria-describedby={`${id}-phone-hint ${id}-phone-err`} />
      <span class="field-hint" id={`${id}-phone-hint`}>Only used to call you back. 10 digits, e.g. 98765 43210.</span>
      <p class="field-error" id={`${id}-phone-err`} data-err="phone" hidden><Icon name="alert" size={16} stroke={2} /><span></span></p>
    </div>

    <div class="field-group">
      <label class="field-label" for={`${id}-cafe`}>Café or restaurant name <span class="opt">(optional)</span></label>
      <input class="field" id={`${id}-cafe`} name="cafe" type="text" autocomplete="organization" />
    </div>

    <div class="enq__pair">
      <div class="field-group">
        <label class="field-label" for={`${id}-stage`}>Where are you now?</label>
        <div class="select-wrap">
          <select class="field" id={`${id}-stage`} name="stage">
            <option>Planning to open</option>
            <option>Opened in the last year</option>
            <option>Running for over a year</option>
            <option>Running a restaurant</option>
          </select>
          <Icon name="chevron" />
        </div>
      </div>
      <div class="field-group">
        <label class="field-label" for={`${id}-team`}>Team size</label>
        <div class="select-wrap">
          <select class="field" id={`${id}-team`} name="team_size">
            <option>Just me</option>
            <option>1–2 people</option>
            <option>3–6 people</option>
            <option>7 or more</option>
          </select>
          <Icon name="chevron" />
        </div>
      </div>
    </div>

    <div class="field-group">
      <label class="field-label" for={`${id}-msg`}>What's on your mind? <span class="opt">(optional)</span></label>
      <textarea class="field" id={`${id}-msg`} name="message" rows="3" placeholder="e.g. Our weekend service feels chaotic"></textarea>
    </div>

    <fieldset class="enq__radios">
      <legend class="field-label">Best way to reach you</legend>
      <div class="enq__pills">
        <label class="pill-radio"><input type="radio" name="contact_via" value="Phone call" checked />Phone call</label>
        <label class="pill-radio"><input type="radio" name="contact_via" value="WhatsApp" />WhatsApp</label>
      </div>
    </fieldset>

    <button class="btn btn-primary btn--lg btn--block" type="submit" data-submit><span data-submit-label>Request my free chat</span> <Icon name="arrow" /></button>
    <p class="field-error enq__fail" data-fail role="alert" hidden></p>
    <p class="enq__note">Free, no obligation. Deepak replies personally within <span set:html={replyHtml} /> working days.</p>
  </form>

  <div class="enq__done print-in" data-done role="status" tabindex="-1" hidden>
    <span class="stamp-mark stamp stamp-now enq__stamp">ORDER UP</span>
    <h3 class="enq__title">Thank you, <span data-first>there</span>. Your table is booked.</h3>
    <p>Deepak will get in touch on the number you shared to set up your free chai pe charcha. Nothing to prepare — just tell him about your café.</p>
    <div class="enq__status mono"><span>Status · Received</span><span>Next · A call from Deepak</span></div>
    <button class="btn btn-ghost" type="button" data-again>Send another enquiry</button>
  </div>
</div>

<style>
  .enq { background: var(--paper); color: var(--ink); border: 1px solid var(--ink); border-radius: 6px; box-shadow: 6px 6px 0 var(--ink); font-size: 16px; line-height: 1.5; }
  .enq__top { display: flex; justify-content: space-between; gap: 12px; padding: 14px clamp(20px, 3vw, 36px); border-bottom: 1px dashed var(--ink); color: var(--muted); }
  .enq__form { display: flex; flex-direction: column; gap: 20px; padding: clamp(20px, 3vw, 36px); }
  .enq__pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 20px; }
  .enq__radios { border: 0; margin: 0; padding: 0; }
  .enq__radios legend { padding: 0; margin-bottom: 10px; }
  .enq__pills { display: flex; flex-wrap: wrap; gap: 12px; }
  .enq__note { font-size: 14px; color: var(--muted); text-align: center; }
  .enq__fail { justify-content: center; text-align: center; }
  .enq__fail a { color: var(--red-text); font-weight: 600; }
  .enq__done { padding: clamp(28px, 4vw, 48px) clamp(20px, 3vw, 36px); display: flex; flex-direction: column; gap: 20px; outline: none; }
  .enq__stamp { align-self: flex-start; border-width: 2.5px; padding: 6px 12px; font-size: 14px; letter-spacing: 0.08em; }
  .enq__title { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(28px, 3vw, 38px); line-height: 1.1; }
  .enq__done p { font-size: 17px; line-height: 1.6; color: var(--body-2); }
  .enq__status { border-top: 1px dashed var(--ink); padding-top: 16px; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; color: var(--muted); }
  .enq__done .btn { align-self: flex-start; min-height: 48px; font-size: 15px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-enquiry]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const done = root.querySelector<HTMLElement>('[data-done]')!;
    const fail = root.querySelector<HTMLElement>('[data-fail]')!;
    const submit = root.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = root.querySelector<HTMLElement>('[data-submit-label]')!;
    const key = root.dataset.key;
    const isDev = root.dataset.dev === '1';
    const callHref = (document.querySelector('.topbar__call') as HTMLAnchorElement | null)?.href || '/contact/';

    const showError = (name: string, msg: string) => {
      const input = form.elements.namedItem(name) as HTMLInputElement;
      const box = root.querySelector<HTMLElement>(`[data-err="${name}"]`)!;
      box.querySelector('span')!.textContent = msg;
      box.hidden = false;
      input.setAttribute('aria-invalid', 'true');
    };
    const clearError = (name: string) => {
      const input = form.elements.namedItem(name) as HTMLInputElement;
      root.querySelector<HTMLElement>(`[data-err="${name}"]`)!.hidden = true;
      input.removeAttribute('aria-invalid');
    };
    ['name', 'phone'].forEach((n) => (form.elements.namedItem(n) as HTMLInputElement).addEventListener('input', () => clearError(n)));

    const validate = () => {
      let firstBad: HTMLInputElement | null = null;
      const name = (form.elements.namedItem('name') as HTMLInputElement);
      const phone = (form.elements.namedItem('phone') as HTMLInputElement);
      if (!name.value.trim()) { showError('name', 'Please tell us your name.'); firstBad ??= name; }
      const digits = phone.value.replace(/\D/g, '');
      const ok = digits.length === 10 || (digits.length === 12 && digits.startsWith('91'));
      if (!ok) {
        showError('phone', digits.length ? 'That number looks incomplete. Enter 10 digits, e.g. 98765 43210.' : 'Add a number so Deepak can call you back.');
        firstBad ??= phone;
      }
      firstBad?.focus();
      return !firstBad;
    };

    const setSending = (on: boolean) => {
      submit.setAttribute('aria-disabled', String(on));
      submitLabel.textContent = on ? 'Sending…' : 'Request my free chat';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submit.getAttribute('aria-disabled') === 'true') return;
      fail.hidden = true;
      if (!validate()) return;
      setSending(true);
      try {
        if (!key) {
          if (!isDev) throw new Error('not-configured');
          await new Promise((r) => setTimeout(r, 700)); // dev: simulate a send
        } else {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          const json = await res.json().catch(() => ({}));
          if (!res.ok || !json.success) throw new Error('send-failed');
        }
        const first = (form.elements.namedItem('name') as HTMLInputElement).value.trim().split(/\s+/)[0];
        root.querySelector('[data-first]')!.textContent = first || 'there';
        form.hidden = true;
        done.hidden = false;
        done.focus();
      } catch (err) {
        fail.innerHTML = (err as Error).message === 'not-configured'
          ? `The form isn't switched on yet. Please <a href="${callHref}">call or WhatsApp Deepak</a> instead.`
          : `Sorry — that didn't go through. Please try again, or <a href="${callHref}">call or WhatsApp Deepak</a>.`;
        fail.hidden = false;
      } finally {
        setSending(false);
      }
    });

    root.querySelector('[data-again]')!.addEventListener('click', () => {
      form.reset();
      done.hidden = true;
      form.hidden = false;
      (form.elements.namedItem('name') as HTMLInputElement).focus();
    });
  });
</script>
