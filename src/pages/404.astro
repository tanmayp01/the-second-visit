---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" noindex mobileBar={false}>
  <section class="nf">
    <div class="container nf__inner">
      <div class="ticket nf__ticket">
        <div class="ticket__row mono nf__row"><span>Table 404</span><span>Not on the menu</span></div>
        <div class="nf__body">
          <h1 class="h2">We couldn’t find that table.</h1>
          <p class="body-2" style="margin-top: 16px;">The page you’re looking for has moved or never existed. Let’s get you seated somewhere better.</p>
          <div class="nf__btns">
            <a class="btn btn-primary" href="/">Back to the homepage <Icon name="arrow" /></a>
            <a class="btn btn-ghost" href="/contact/">Contact Deepak</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(64px, 10vw, 140px); }
  .nf__inner { display: flex; justify-content: center; }
  .nf__ticket { max-width: 640px; width: 100%; }
  .nf__row { padding: 14px 24px; border-bottom: 1px dashed var(--ink); }
  .nf__body { padding: clamp(24px, 4vw, 40px); }
  .body-2 { color: var(--body-2); }
  .nf__btns { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 12px; }
</style>
