---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Film from '../components/Film.astro';
import { site } from '../config/site';
import { films } from '../config/media';

const expertise = [
  ['The guest', ['Guest experience and customer relationships', 'Understanding expectations and spotting service gaps', 'Collecting, reading and acting on feedback', 'Encouraging repeat visits and loyal regulars']],
  ['The team', ['Staff training and coaching', 'Consistent service, shift after shift', 'Helping teams build better working habits']],
  ['The operation', ['Inventory, stock control and efficiency', 'Hospitality software and daily workflows', 'How systems, staff and guest satisfaction affect each other']],
] as const;
// Set to true once Deepak has approved the quote wording.
const quoteApproved = false;
---
<Base title="About Deepak Thapliyal" description="Deepak Thapliyal has spent more than fifteen years in hospitality and management. Meet the mentor behind The Second Visit, Dehradun." active="about">
  <section class="a-hero" aria-labelledby="about-h">
    <div class="container a-hero__grid">
      <div class="a-hero__text">
        <p class="label in in-1">About Deepak</p>
        <h1 id="about-h" class="h1 in in-2">Hospitality, learned <em>from the ground up</em>.</h1>
        <hr class="rule in in-3" />
        <p class="lead in in-3">More than fifteen years in hospitality and management, across different levels of the industry. The Second Visit is how Deepak shares what those years taught him with café and restaurant owners in {site.city}.</p>
      </div>
      <Photo class="unveil" eager tag="Portrait of Deepak" ratio="4 / 5" alt="Deepak in a café before opening" brief="Environmental portrait: Deepak in a café before opening, chairs still up, morning light." />
    </div>
  </section>

  <section class="section section--ivory" aria-labelledby="story-h">
    <div class="container split">
      <div style="flex: 1 1 320px;">
        <p class="label">The story</p>
        <h2 id="story-h" class="h2" style="margin-top: 24px;">The long <em>way round</em>.</h2>
      </div>
      <div class="story" style="flex: 1.6 1 560px;">
        <p class="story__lead">Deepak has more than fifteen years of experience in hospitality and management. He has worked across different levels of the industry, learning how hotels, restaurants, cafés, teams and day-to-day operations work from the ground up.</p>
        <p>His experience covers both sides of the business. On the guest side: understanding what guests expect, building relationships, collecting and acting on feedback, and encouraging repeat visits. On the operational side: training and coaching staff, keeping service consistent, managing inventory and stock, and working with hospitality software and workflows.</p>
        <p>The Second Visit rests on one belief: a beautiful café alone does not bring guests back. The everyday details do, and they can be taught to any team, however small.</p>
        <p class="muted">He also has an educational background in science.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="path-h">
    <div class="container">
      <div class="split" style="align-items: flex-end;">
        <div style="flex: 1 1 420px;">
          <p class="label">Career</p>
          <h2 id="path-h" class="h2" style="margin-top: 24px;">Where he has <em>worked</em>.</h2>
        </div>
        {!site.previousRoles.length && <p style="flex: 0 1 auto;"><span class="ph small">Earlier roles to be confirmed with Deepak</span></p>}
      </div>
      <ol class="path">
        <li><span class="path__when">Today</span><span class="path__role">Guest experience &amp; client relations</span><span class="path__where">SOCIAL</span></li>
        {site.previousRoles.length
          ? site.previousRoles.map((r) => <li><span class="path__when">{r.years}</span><span class="path__role">{r.role}</span><span class="path__where">{r.place}</span></li>)
          : [1, 2, 3].map(() => <li class="path--ph"><span class="path__when">[Years]</span><span class="path__role">[Role]</span><span class="path__where">[Venue]</span></li>)}
      </ol>
    </div>
  </section>

  <Film film={films.lobby} size="medium">
    <p class="label">Today</p>
    <h2 class="h2 film-h">Still working <em>with guests today</em>.</h2>
    <p class="film-p">Deepak currently works with SOCIAL in a guest-experience and client-relationship role. He talks to guests, understands their experiences, picks up on concerns and helps teams keep the experience consistent. His mentorship draws on that day-to-day work.</p>
    <p class="film-note">The Second Visit is Deepak’s own independent initiative. It is not affiliated with, or endorsed by, SOCIAL.</p>
  </Film>

  <section class="section" aria-labelledby="knows-h">
    <div class="container">
      <div class="center narrow" style="margin-inline: auto; padding: 0;">
        <p class="label">Expertise</p>
        <h2 id="knows-h" class="h2" style="margin-top: 24px;">The guest, the team <em>and the back office</em>.</h2>
      </div>
      <div class="knows">
        {expertise.map(([t, items]) => (
          <div class="reveal"><h3 class="h3">{t}</h3><ul>{items.map((i) => <li>{i}</li>)}</ul></div>
        ))}
      </div>
      {quoteApproved && (
        <blockquote class="quote">
          <p>“{site.city} is full of beautiful new cafés. I want the people who open them to still be serving their regulars years from now.”</p>
          <footer class="label">{site.owner}</footer>
        </blockquote>
      )}
      <div class="center" style="margin-top: clamp(64px, 8vw, 112px);">
        <a class="btn btn--solid" href="/contact/">Book a consultation <Icon name="arrow" size={16} stroke={1.5} /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .a-hero { padding: clamp(24px, 4vw, 64px) 0 clamp(72px, 9vw, 140px); }
  .a-hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: clamp(40px, 7vw, 120px); align-items: end; }
  .a-hero__text .h1 { margin-top: 28px; font-size: clamp(48px, 6.2vw, 96px); }
  .a-hero__text .rule { margin-top: 40px; }
  .a-hero__text .lead { margin-top: 32px; }
  @media (max-width: 899px) { .a-hero__grid { grid-template-columns: 1fr; } }
  .story { display: flex; flex-direction: column; gap: 22px; max-width: 680px; }
  .story__lead { font-size: clamp(19px, 1.55vw, 22px); line-height: 1.6; color: var(--ink); }
  .path { margin-top: clamp(48px, 6vw, 72px); border-top: 1px solid var(--ink); }
  .path li { display: grid; grid-template-columns: minmax(100px, 1fr) minmax(0, 2fr) minmax(0, 1.2fr); gap: 8px 32px; padding: 28px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .path__when { font-family: var(--font-ui); font-size: 12px; font-weight: 400; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
  .path__role { font-family: var(--font-display); font-size: clamp(22px, 2vw, 28px); color: var(--ink); }
  .path--ph > * { color: var(--muted) !important; }
  @media (max-width: 700px) { .path li { grid-template-columns: 1fr; } }
  .film-h { margin-top: 24px; color: var(--on-dark) !important; }
  .film-p { margin: 28px auto 0; max-width: 40em; font-size: 18px; color: var(--on-dark); }
  .film-note { margin: 28px auto 0; max-width: 40em; font-size: 13px; color: var(--on-dark-muted); }
  .knows { margin-top: clamp(56px, 7vw, 96px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 48px; }
  .knows .h3 { padding-bottom: 20px; border-bottom: 1px solid var(--ink); }
  .knows li { padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 16px; }
  .quote { margin: clamp(72px, 9vw, 128px) auto 0; max-width: 900px; text-align: center; }
  .quote p { font-family: var(--font-display); font-weight: 400; font-size: clamp(30px, 3.6vw, 50px); line-height: 1.2; color: var(--ink); }
  .quote footer { margin-top: 28px; }
</style>
