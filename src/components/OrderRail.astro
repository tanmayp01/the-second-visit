---
// Kitchen order rail: tickets carrying the house habits, drifting slowly. Decorative.
const orders = [
  ['01', '08:31', 'Greet them like family.', ''],
  ['02', '09:04', 'Remember the regulars’ order.', ''],
  ['03', '09:40', 'Listen first. Then fix it.', ''],
  ['04', '10:15', 'Count the stock before the rush.', ''],
  ['05', '10:52', 'Train the team — even if it’s two.', ''],
  ['06', '11:30', 'Say goodbye properly.', ''],
  ['07', '11:58', 'Come again soon.', 'फिर आइएगा'],
];
const rail = [...orders, ...orders];
---
<div class="marquee" aria-hidden="true">
  <div class="rail-bar"></div>
  <div class="marquee-track">
    {rail.map(([t, time, text, sub], i) => (
      <div class="sway rail-ticket" style={`animation-delay: ${(-(i % 5) * 0.7).toFixed(1)}s`}>
        <span class="rail-clip"></span>
        <div class="rail-paper">
          <div class="ticket__row mono"><span>TBL {t}</span><span>{time}</span></div>
          <hr class="perf" />
          <p class="rail-text">{text}</p>
          {sub && <p lang="hi" class="hindi rail-sub">{sub}</p>}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .marquee { position: relative; padding-bottom: 8px; overflow-x: clip; }
  .rail-bar { height: 12px; background: var(--steel); border-bottom: 3px solid var(--steel-dark); box-shadow: inset 0 2px 0 var(--steel-light); }
  .marquee-track { display: flex; width: max-content; }
  .rail-ticket { flex: none; width: 210px; margin-right: 20px; margin-top: -3px; }
  .rail-clip { display: block; width: 34px; height: 10px; margin: 0 auto; background: var(--steel-light); border-radius: 0 0 3px 3px; }
  .rail-paper { background: var(--paper); color: var(--ink); padding: 12px 14px 16px; border-radius: 0 0 3px 3px; }
  .rail-text { font-family: var(--font-display); font-size: 18px; line-height: 1.25; }
  .rail-sub { margin-top: 4px; font-size: 16px; color: var(--red-text); }
</style>
