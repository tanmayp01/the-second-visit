# Copy to .env for local development, and add the same variables in Vercel / Netlify.

# Public URL of the live site, no trailing slash (canonical links, sitemap, social cards).
SITE_URL=https://thesecondvisit.in

# Web3Forms access key (free at https://web3forms.com — sign up with Deepak's email).
# Enquiries are emailed to the address the key was created with.
PUBLIC_WEB3FORMS_KEY=
