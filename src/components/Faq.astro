---
interface Props {
  /** `a` may contain simple HTML (e.g. a placeholder span). */
  items: { q: string; a: string }[];
  group: string;
  openFirst?: boolean;
}
const { items, group, openFirst = false } = Astro.props;
---
<div class="faq">
  {items.map((item, i) => (
    <details name={group} open={openFirst && i === 0}>
      <summary>
        <span>{item.q}</span>
        <span class="faq__icon" aria-hidden="true"></span>
      </summary>
      <div class="faq__a"><p set:html={item.a} /></div>
    </details>
  ))}
</div>
