---
import Icon from './Icon.astro';
import { site, telHref, phHtml } from '../config/site';

interface Props { id?: string }
const { id = 'enquiry' } = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const replyHtml = phHtml(site.replyDays, 'X');
---
<div class="enq" data-enquiry data-key={accessKey} data-dev={import.meta.env.DEV ? '1' : ''} data-call={telHref()}>
  <form class="enq__form" action="https://api.web3forms.com/submit" method="POST" novalidate aria-label="Request a consultation" data-form>
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="New enquiry from The Second Visit website" />
    <input type="hidden" name="from_name" value="The Second Visit website" />
    <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="enq__pair">
      <div class="field-group">
        <label class="field-label" for={`${id}-name`}>Your name</label>
        <input class="field" id={`${id}-name`} name="name" type="text" autocomplete="name" required aria-describedby={`${id}-name-err`} />
        <p class="field-error" id={`${id}-name-err`} data-err="name" hidden><Icon name="alert" size={15} stroke={1.8} /><span></span></p>
      </div>
      <div class="field-group">
        <label class="field-label" for={`${id}-phone`}>Phone or WhatsApp</label>
        <input class="field" id={`${id}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel" required aria-describedby={`${id}-phone-hint ${id}-phone-err`} />
        <span class="field-hint" id={`${id}-phone-hint`}>10 digits, e.g. 98765 43210</span>
        <p class="field-error" id={`${id}-phone-err`} data-err="phone" hidden><Icon name="alert" size={15} stroke={1.8} /><span></span></p>
      </div>
    </div>

    <div class="field-group">
      <label class="field-label" for={`${id}-cafe`}>Café or restaurant <span class="opt">(optional)</span></label>
      <input class="field" id={`${id}-cafe`} name="cafe" type="text" autocomplete="organization" />
    </div>

    <div class="enq__pair">
      <div class="field-group">
        <label class="field-label" for={`${id}-stage`}>Where you are now</label>
        <div class="select-wrap">
          <select class="field" id={`${id}-stage`} name="stage">
            <option>Planning to open</option>
            <option>Opened in the last year</option>
            <option>Running for over a year</option>
            <option>Running a restaurant</option>
          </select>
          <Icon name="chevron" size={16} />
        </div>
      </div>
      <div class="field-group">
        <label class="field-label" for={`${id}-team`}>Team size</label>
        <div class="select-wrap">
          <select class="field" id={`${id}-team`} name="team_size">
            <option>Just me</option>
            <option>1 or 2 people</option>
            <option>3 to 6 people</option>
            <option>7 or more</option>
          </select>
          <Icon name="chevron" size={16} />
        </div>
      </div>
    </div>

    <div class="field-group">
      <label class="field-label" for={`${id}-msg`}>What would you like help with? <span class="opt">(optional)</span></label>
      <textarea class="field" id={`${id}-msg`} name="message" rows="3" placeholder="For example, our weekend service feels rushed"></textarea>
    </div>

    <fieldset class="enq__radios">
      <legend class="field-label">Best way to reach you</legend>
      <div class="enq__choices">
        <label class="choice"><input type="radio" name="contact_via" value="Phone call" checked />Phone call</label>
        <label class="choice"><input type="radio" name="contact_via" value="WhatsApp" />WhatsApp</label>
      </div>
    </fieldset>

    <div class="enq__submit">
      <button class="btn btn--solid" type="submit" data-submit><span data-submit-label>Request a consultation</span> <Icon name="arrow" size={16} stroke={1.5} /></button>
      <p class="enq__note">Free and without obligation. Deepak replies personally within <span set:html={replyHtml} /> working days. Your details are used only to reply to you; see the <a class="ulink" href="/privacy/">Privacy Policy</a>.</p>
    </div>
    <p class="field-error enq__fail" data-fail role="alert" hidden></p>
  </form>

  <div class="enq__done" data-done role="status" tabindex="-1" hidden>
    <p class="label">Request received</p>
    <h3 class="h2 enq__title">Thank you, <em data-first>there</em>.</h3>
    <p class="lead">Deepak will call you on the number you shared to arrange your free first conversation. There's nothing to prepare.</p>
    <button class="link" type="button" data-again>Send another enquiry</button>
  </div>
</div>

<style>
  .enq__form { display: flex; flex-direction: column; gap: 36px; }
  .enq__pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 36px 40px; }
  .enq__radios { border: 0; margin: 0; padding: 0; }
  .enq__radios legend { padding: 0; margin-bottom: 8px; }
  .enq__choices { display: flex; flex-wrap: wrap; gap: 8px 36px; }
  .enq__submit { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 32px; padding-top: 8px; }
  .enq__note { flex: 1 1 260px; font-size: 14px; color: var(--muted); }
  .enq__fail a { color: var(--error); font-weight: 500; }
  .enq__done { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; outline: none; padding-block: 24px; }
  .enq__done .link { border: 0; cursor: pointer; }
  @media (prefers-reduced-motion: no-preference) { .enq__done:not([hidden]) { animation: fade-up .8s var(--ease) both; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-enquiry]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const done = root.querySelector<HTMLElement>('[data-done]')!;
    const fail = root.querySelector<HTMLElement>('[data-fail]')!;
    const submit = root.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = root.querySelector<HTMLElement>('[data-submit-label]')!;
    const key = root.dataset.key;
    const isDev = root.dataset.dev === '1';
    const callHref = root.dataset.call || '/contact/';

    const showError = (name: string, msg: string) => {
      const input = form.elements.namedItem(name) as HTMLInputElement;
      const box = root.querySelector<HTMLElement>(`[data-err="${name}"]`)!;
      box.querySelector('span')!.textContent = msg;
      box.hidden = false;
      input.setAttribute('aria-invalid', 'true');
    };
    const clearError = (name: string) => {
      const input = form.elements.namedItem(name) as HTMLInputElement;
      root.querySelector<HTMLElement>(`[data-err="${name}"]`)!.hidden = true;
      input.removeAttribute('aria-invalid');
    };
    ['name', 'phone'].forEach((n) => (form.elements.namedItem(n) as HTMLInputElement).addEventListener('input', () => clearError(n)));

    const validate = () => {
      let firstBad: HTMLInputElement | null = null;
      const name = (form.elements.namedItem('name') as HTMLInputElement);
      const phone = (form.elements.namedItem('phone') as HTMLInputElement);
      if (!name.value.trim()) { showError('name', 'Please tell us your name.'); firstBad ??= name; }
      const digits = phone.value.replace(/\D/g, '');
      const ok = digits.length === 10 || (digits.length === 12 && digits.startsWith('91'));
      if (!ok) {
        showError('phone', digits.length ? 'That number looks incomplete. Enter 10 digits, e.g. 98765 43210.' : 'Add a number so Deepak can call you back.');
        firstBad ??= phone;
      }
      firstBad?.focus();
      return !firstBad;
    };

    const setSending = (on: boolean) => {
      submit.setAttribute('aria-disabled', String(on));
      submitLabel.textContent = on ? 'Sending…' : 'Request a consultation';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submit.getAttribute('aria-disabled') === 'true') return;
      fail.hidden = true;
      if (!validate()) return;
      setSending(true);
      try {
        if (!key) {
          if (!isDev) throw new Error('not-configured');
          await new Promise((r) => setTimeout(r, 700)); // dev: simulate a send
        } else {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          const json = await res.json().catch(() => ({}));
          if (!res.ok || !json.success) throw new Error('send-failed');
        }
        const first = (form.elements.namedItem('name') as HTMLInputElement).value.trim().split(/\s+/)[0];
        root.querySelector('[data-first]')!.textContent = first || 'there';
        form.hidden = true;
        done.hidden = false;
        done.focus();
      } catch (err) {
        fail.innerHTML = (err as Error).message === 'not-configured'
          ? `The form isn't switched on yet. Please <a href="${callHref}">call or WhatsApp Deepak</a> instead.`
          : `Sorry, that didn't go through. Please try again, or <a href="${callHref}">call or WhatsApp Deepak</a>.`;
        fail.hidden = false;
      } finally {
        setSending(false);
      }
    });

    root.querySelector('[data-again]')!.addEventListener('click', () => {
      form.reset();
      done.hidden = true;
      form.hidden = false;
      (form.elements.namedItem('name') as HTMLInputElement).focus();
    });
  });
</script>
