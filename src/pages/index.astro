---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Film from '../components/Film.astro';
import Faq from '../components/Faq.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site, telHref, mailHref, phHtml } from '../config/site';
import { films } from '../config/media';

const price = phHtml(site.priceFrom, 'X,XXX');
const phone = phHtml(site.phoneDisplay, '+91 XXXXX XXXXX');

const gaps = [
  ['The welcome', 'How a guest is greeted depends on who happens to be on shift.'],
  ['The feedback', 'Comments are heard at the counter, then nothing in the routine changes.'],
  ['The stock', 'Items run out mid-service, or quietly expire at the back of the shelf.'],
  ['The team', 'Good people guessing at what good service looks like, because no one has shown them.'],
];
const pillars = [
  { label: 'The guest', title: 'How guests feel', items: ['The welcome and the goodbye', 'Talking with guests and knowing regulars', 'Feedback and complaint recovery', 'Earning repeat visits, honestly'] },
  { label: 'The team', title: 'How your team serves', items: ['Hands-on training, even for one or two people', 'Simple service standards for every shift', 'Behaviour on the floor and during a rush', 'Habits that last after the sessions end'] },
  { label: 'The operation', title: 'How the café runs', items: ['Stock control, ordering and less waste', 'Opening, closing and service routines', 'Getting more from the software you have', 'Pre-opening plans for new cafés'] },
];
const steps = [
  ['I', 'A first conversation', 'Free and without obligation, by phone or over chai. You talk about your café; Deepak listens.'],
  ['II', 'Deepak visits', 'He experiences your café during service the way a guest would: the welcome, the wait, the bill, the goodbye.'],
  ['III', 'Morning sessions', 'On-site, before you open, with you, your team or both, focused on what he saw.'],
  ['IV', 'A follow-up', 'Once the new habits have settled, he checks what is working and adjusts the rest.'],
];
const morning = [['08:30', 'Team arrives'], ['09:00', 'The session'], ['10:30', 'Practice on the floor'], ['12:00', 'Doors open']];
const faqs = [
  { q: 'Is the first conversation really free?', a: 'Yes. The first conversation, on the phone or over a cup of chai, is free and comes with no obligation. It is a chance for Deepak to understand your café, and for you to decide whether the mentorship is right for you.' },
  { q: 'My team is only two people. Is this for me?', a: 'Very much. The mentorship is built for small, independent cafés. Training one or two people well often makes the biggest difference to how a guest feels.' },
  { q: 'Will the sessions get in the way of running my café?', a: 'Sessions are planned for the morning, before you open, and usually finish before 12 or 1 PM depending on your café. Your team learns first, then practises on real guests the same day.' },
  { q: 'What does it cost?', a: `The mentorship starts from ₹${price}. The final fee depends on your team size, the number of sessions and your location, and is agreed with you before anything begins.` },
  { q: 'We have not opened yet. Is it too early?', a: 'It is one of the best times. Habits are easier to build before the first guest walks in than to change afterwards. Deepak can help you plan service, roles and routines before opening day.' },
  { q: 'Can you guarantee more customers?', a: 'No, and be wary of anyone who does. What Deepak can promise is honest, practical work on the things guests notice: how they are welcomed, served and listened to. Those are the reasons people come back.' },
];
---
<Base title="Home" active="home">
  <!-- 1. DEEPAK -->
  <section class="intro" aria-labelledby="intro-h">
    <div class="container intro__grid">
      <div class="intro__photo">
        <Photo class="unveil" eager tag="Portrait of Deepak" ratio="4 / 5" alt="Portrait of Deepak Thapliyal in a café" brief="Deepak in a café before opening, in natural morning light. Looking at the room, not posed against a backdrop." sizes="(max-width: 900px) 100vw, 46vw" />
      </div>
      <div class="intro__text">
        <p class="label in in-1">Hospitality mentor · {site.city}</p>
        <h1 id="intro-h" class="h1 in in-2">Deepak <em>Thapliyal</em></h1>
        <hr class="rule in in-3" />
        <p class="intro__lead in in-3">Fifteen years in hotels, restaurants and cafés, from the guest at the table to the stockroom at the back. Today he works in guest experience, listening to what guests feel and helping teams put it right.</p>
        <p class="lead in in-4">Through <strong>The Second Visit</strong>, he now brings that experience to the café and restaurant owners of {site.city}, in their own cafés, in the morning, before service.</p>
        <dl class="facts in in-4">
          <div><dt class="label">Experience</dt><dd>15+ years</dd></div>
          <div><dt class="label">Range</dt><dd>Front &amp; back of house</dd></div>
          <div><dt class="label">Today</dt><dd>Guest experience</dd></div>
        </dl>
        <div class="intro__ctas in in-5">
          <a class="btn btn--solid" href="#enquire">Book a consultation <Icon name="arrow" size={16} stroke={1.5} /></a>
          <a class="link" href="/about/">His story</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. THESIS -->
  <section class="section thesis" aria-labelledby="thesis-h">
    <div class="container narrow center">
      <p class="label">The Second Visit</p>
      <h2 id="thesis-h" class="h2 thesis__h">Beautiful cafés win the first visit. <em>Hospitality wins the second.</em></h2>
      <p class="lead thesis__p">Interiors, coffee machines and menus bring people through the door once. What brings them back is how they were welcomed, whether they were heard, and whether the team made them feel at home. That part can be taught.</p>
    </div>
  </section>

  <!-- 3. FILM: PHILOSOPHY -->
  <Film film={films.chai}>
    <p class="label">The philosophy</p>
    <blockquote class="film-quote">
      <p>“A café shouldn’t only attract people once. It should give them <em>a reason to return</em>.”</p>
    </blockquote>
    <p lang="hi" class="hindi film-hindi">अतिथि देवो भव</p>
  </Film>

  <!-- 4. THE GAP -->
  <section class="section" aria-labelledby="gap-h">
    <div class="container split">
      <div style="flex: 1 1 380px;">
        <p class="label">After the fit-out</p>
        <h2 id="gap-h" class="h2" style="margin-top: 24px;">Where most new cafés <em>quietly lose</em> their guests.</h2>
      </div>
      <dl class="gaps" style="flex: 1.3 1 520px;">
        {gaps.map(([t, d]) => (
          <div class="reveal"><dt class="h3">{t}</dt><dd>{d}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 5. THE MENTORSHIP -->
  <section class="section section--ivory" aria-labelledby="m-h">
    <div class="container">
      <div class="center narrow" style="margin-inline: auto; padding: 0;">
        <p class="label">The mentorship</p>
        <h2 id="m-h" class="h2" style="margin-top: 24px;">One mentorship, <em>shaped around your café</em>.</h2>
        <p class="lead" style="margin: 28px auto 0;">No fixed course and no slides. Deepak starts with how your café actually runs, then works with you and your team on what matters most.</p>
      </div>
      <div class="pillars">
        {pillars.map((p) => (
          <div class="pillar reveal">
            <p class="label">{p.label}</p>
            <h3 class="h3">{p.title}</h3>
            <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
      <div class="price-row">
        <p><span class="label">From</span> <span class="price">₹<span set:html={price} /></span></p>
        <p class="muted small">Agreed with you after the first visit, before anything begins.</p>
        <a class="link" href="/mentorship/">The full mentorship</a>
      </div>
    </div>
  </section>

  <!-- 6. FILM: THE MORNING -->
  <Film film={films.kitchen} size="medium" align="left" id="how">
    <p class="label">The format</p>
    <h2 class="h2 film-h">Learned in the morning. <em>Served by noon.</em></h2>
    <p class="film-p">Sessions take place in your café before you open, so the team practises on real guests the same day.</p>
    <ol class="timeline">
      {morning.map(([t, l]) => <li><span class="timeline__t">{t}</span><span class="timeline__l">{l}</span></li>)}
    </ol>
  </Film>

  <!-- 7. HOW IT WORKS -->
  <section class="section" aria-labelledby="how-h">
    <div class="container">
      <div class="split" style="align-items: flex-end;">
        <div style="flex: 1 1 420px;">
          <p class="label">How it works</p>
          <h2 id="how-h" class="h2" style="margin-top: 24px;">From the first chai <em>to the follow-up</em>.</h2>
        </div>
        <p class="lead" style="flex: 1 1 380px;">Every engagement follows the same simple shape. The number of sessions is agreed with you once Deepak has seen your café.</p>
      </div>
      <ol class="steps">
        {steps.map(([n, t, d]) => (
          <li class="reveal"><span class="steps__n">{n}</span><h3 class="h3">{t}</h3><p>{d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 8. WHO IT'S FOR -->
  <section class="section section--ivory" aria-labelledby="who-h">
    <div class="container split">
      <div style="flex: 1 1 380px;">
        <p class="label">Who it is for</p>
        <h2 id="who-h" class="h2" style="margin-top: 24px;">For owners who care <em>how it feels</em>.</h2>
      </div>
      <div class="who" style="flex: 1.3 1 520px;">
        <ul class="who__list">
          <li>You are planning a café and want to open with the right habits.</li>
          <li>Your café opened recently and you are still finding your rhythm.</li>
          <li>You run a small team, even just one or two people.</li>
          <li>You run a restaurant and want service to feel the same on every shift.</li>
        </ul>
        <p class="who__not"><strong>Not the right fit</strong> if you need interiors, menu design or social media, or if you want guaranteed numbers. Deepak won’t promise percentages.</p>
      </div>
    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="section" aria-labelledby="faq-h">
    <div class="container split">
      <div style="flex: 1 1 320px;">
        <p class="label">Questions</p>
        <h2 id="faq-h" class="h2" style="margin-top: 24px;">What owners <em>usually ask</em>.</h2>
        <p style="margin-top: 28px;">Something else? Call or WhatsApp <a class="ulink" href={telHref()} set:html={phone} />.</p>
      </div>
      <div style="flex: 1.6 1 560px;">
        <Faq group="home-faq" items={faqs} />
      </div>
    </div>
  </section>

  <!-- 10. ENQUIRY -->
  <section id="enquire" class="section section--ivory enquire" aria-labelledby="enq-h">
    <div class="container split">
      <div style="flex: 1 1 360px;">
        <p class="label">Free first conversation</p>
        <h2 id="enq-h" class="h2" style="margin-top: 24px;">Begin with <em>a conversation</em>.</h2>
        <p class="lead" style="margin-top: 28px;">Tell Deepak a little about your café. He will call you to arrange a first conversation, free and without obligation.</p>
        <dl class="contacts">
          <div><dt class="label">Call or WhatsApp</dt><dd><a href={telHref()} set:html={phone} /></dd></div>
          <div><dt class="label">Email</dt><dd><a href={mailHref()} set:html={phHtml(site.email, 'email address')} /></dd></div>
          <div><dt class="label">Based in</dt><dd>{site.city}, {site.region}</dd></div>
        </dl>
      </div>
      <div style="flex: 1.4 1 520px;">
        <EnquiryForm id="home" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* intro */
  .intro { padding: clamp(24px, 4vw, 64px) 0 clamp(72px, 9vw, 140px); }
  .intro__grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr); gap: clamp(40px, 6vw, 104px); align-items: center; }
  .intro__photo :global(.photo) { max-height: 86vh; width: 100%; }
  .intro__text .h1 { margin-top: 28px; }
  .intro__text .rule { margin-top: 36px; }
  .intro__lead { margin-top: 32px; font-family: var(--font-display); font-size: clamp(24px, 2.2vw, 31px); line-height: 1.38; color: var(--ink); max-width: 30em; }
  .intro__text .lead { margin-top: 20px; }
  .facts { margin-top: 44px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .facts div { padding: 20px 16px 0 0; }
  .facts dd { margin-top: 8px; font-family: var(--font-display); font-size: clamp(20px, 1.7vw, 24px); line-height: 1.25; color: var(--ink); }
  .intro__ctas { margin-top: 44px; display: flex; flex-wrap: wrap; align-items: center; gap: 24px 36px; }
  @media (max-width: 899px) {
    .intro__grid { grid-template-columns: 1fr; }
    .intro__photo :global(.photo) { aspect-ratio: 4 / 4.4 !important; max-height: none; }
  }
  @media (max-width: 480px) { .facts { grid-template-columns: 1fr; } .facts div { padding: 14px 0; border-bottom: 1px solid var(--line); } }

  /* thesis */
  .thesis__h { margin-top: 28px; }
  .thesis__p { margin: 36px auto 0; }

  /* film content */
  .film-quote p { margin: 32px auto 0; max-width: 20ch; font-family: var(--font-display); font-weight: 300; font-size: clamp(38px, 5.2vw, 76px); line-height: 1.1; color: var(--on-dark); text-wrap: balance; }
  .film-hindi { margin-top: 36px; font-size: 22px; color: var(--gold-soft); }
  .film-h { margin-top: 24px; max-width: 14ch; color: var(--on-dark) !important; }
  .film-p { margin-top: 24px; max-width: 34em; font-size: 18px; color: var(--on-dark); opacity: .9; }
  .timeline { margin-top: clamp(48px, 6vw, 72px); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); max-width: 880px; border-top: 1px solid rgba(244,240,233,.4); }
  .timeline li { padding: 20px 16px 0 0; position: relative; }
  .timeline li::before { content: ""; position: absolute; top: -4px; left: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--on-dark); }
  .timeline li:last-child::before { background: var(--gold-soft); box-shadow: 0 0 0 5px rgba(201,174,126,.25); }
  .timeline__t { display: block; font-family: var(--font-display); font-size: clamp(26px, 2.6vw, 36px); color: var(--on-dark); line-height: 1; }
  .timeline__l { display: block; margin-top: 8px; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--on-dark-muted); }
  @media (max-width: 600px) { .timeline { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 28px; } }

  /* gaps */
  .gaps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 48px 56px; }
  .gaps div { border-top: 1px solid var(--line); padding-top: 24px; }
  .gaps dd { margin-top: 12px; }

  /* pillars */
  .pillars { margin-top: clamp(56px, 7vw, 96px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 48px; }
  .pillar { background: var(--white); padding: clamp(32px, 3.5vw, 48px); }
  .pillar .h3 { margin-top: 16px; }
  .pillar ul { margin-top: 28px; }
  .pillar li { padding: 13px 0; border-top: 1px solid var(--line); font-size: 16px; }
  .price-row { margin-top: clamp(48px, 6vw, 72px); display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 12px 40px; text-align: center; }
  .price { font-family: var(--font-display); font-size: clamp(34px, 3.4vw, 46px); color: var(--ink); margin-left: 10px; }

  /* steps */
  .steps { margin-top: clamp(56px, 7vw, 96px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 48px 40px; }
  .steps li { border-top: 1px solid var(--ink); padding-top: 28px; }
  .steps__n { display: block; font-family: var(--font-display); font-style: italic; font-size: 30px; color: var(--gold); line-height: 1; }
  .steps .h3 { margin-top: 20px; }
  .steps p { margin-top: 14px; font-size: 16px; }

  /* who */
  .who__list li { padding: 22px 0 22px 36px; border-top: 1px solid var(--line-strong); position: relative; font-size: 18px; color: var(--ink); }
  .who__list li::before { content: ""; position: absolute; left: 0; top: 34px; width: 18px; height: 1px; background: var(--gold); }
  .who__not { margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--line-strong); font-size: 16px; }

  /* enquiry */
  .contacts { margin-top: 48px; display: flex; flex-direction: column; gap: 24px; }
  .contacts dd { margin-top: 6px; font-family: var(--font-display); font-size: 24px; color: var(--ink); }
  .contacts a { text-decoration: none; }
</style>
