---
import type { Film } from '../config/media';

interface Props {
  film: Film;
  /** Height of the band. */
  size?: 'tall' | 'medium' | 'full';
  align?: 'center' | 'left';
  id?: string;
}
const { film, size = 'tall', align = 'center', id } = Astro.props;
---
<section class={`film film--${size} film--${align} dark`} id={id} data-film data-hero={size === 'full' ? '' : undefined}>
  <video class="film__video" autoplay muted loop playsinline preload="metadata" poster={film.poster} aria-hidden="true" tabindex="-1" data-film-video>
    <source src={film.src} type="video/mp4" />
  </video>
  <div class="film__shade" aria-hidden="true"></div>
  <div class="container film__inner">
    <slot />
  </div>
  <span class="sr-only">Background video: {film.label}</span>
</section>

<style>
  .film { position: relative; overflow: hidden; display: flex; align-items: center; isolation: isolate; background: var(--deep); }
  .film--tall { min-height: clamp(560px, 92vh, 880px); }
  .film--medium { min-height: clamp(460px, 70vh, 680px); }
  .film--full { min-height: 100vh; min-height: 100svh; }
  @media (max-width: 899px) { .film--full { min-height: calc(100svh - 56px); } }
  .film--full .film__inner { padding-top: clamp(140px, 18vh, 200px); }
  .film__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; filter: saturate(.85); transform: scale(var(--zoom, 1)); will-change: transform; }
  .film__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(10,14,12,.55) 0%, rgba(10,14,12,.35) 45%, rgba(10,14,12,.7) 100%); }
  .film__inner { width: 100%; padding-block: clamp(88px, 10vw, 140px); color: var(--on-dark); }
  .film--center .film__inner { text-align: center; }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-film]').forEach((band) => {
    const video = band.querySelector<HTMLVideoElement>('[data-film-video]')!;
    // Reduced motion: keep the poster frame, never play.
    if (reduce.matches) { video.removeAttribute('autoplay'); video.pause(); return; }
    // Only play while on screen, to save data and battery.
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) video.play().catch(() => {}); else video.pause();
    }, { threshold: 0.1 }).observe(band);

    // Slow zoom-out as the band scrolls through the window.
    let ticking = false;
    const update = () => {
      const r = band.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight - r.top) / (window.innerHeight + r.height)));
      band.style.setProperty('--zoom', (1.06 - p * 0.06).toFixed(4));
      ticking = false;
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  });
</script>
