---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Film from '../components/Film.astro';
import Faq from '../components/Faq.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Compare from '../components/Compare.astro';
import { site, telHref, mailHref, phHtml } from '../config/site';
import { films } from '../config/media';
import { photo } from '../config/photos';

const price = phHtml(site.priceFrom, 'X,XXX');
const phone = phHtml(site.phoneDisplay, '+91 XXXXX XXXXX');

const areas = [
  { img: 'area-welcome', tag: 'The guest', title: 'The welcome and the goodbye', text: 'How guests are greeted, seated, served and seen off, and the small details that make a place feel like theirs.', brief: 'A guest being greeted at the door of a Dehradun café, morning light.' },
  { img: 'area-feedback', tag: 'The guest', title: 'Feedback and complaints', text: 'Collecting feedback, reading it honestly, and recovering well when something goes wrong.', brief: 'A team member listening to a seated guest, notebook in hand.' },
  { img: 'area-training', tag: 'The team', title: 'Training your team', text: 'Hands-on coaching for teams of any size, even one or two people.', brief: 'Two team members practising service at the counter before opening.' },
  { img: 'area-standards', tag: 'The team', title: 'Service standards', text: 'Simple, shared habits so every shift delivers the same café.', brief: 'A neatly set table and a printed one-page service checklist.' },
  { img: 'area-stock', tag: 'The operation', title: 'Stock and inventory', text: 'Stock control, ordering and cutting waste, without complicated software.', brief: 'Labelled shelves in a café storeroom, a clipboard stock count.' },
  { img: 'area-routines', tag: 'The operation', title: 'Workflows and routines', text: 'Opening, closing and service routines that make the day run smoother.', brief: 'Chairs coming down and a team setting up before opening.' },
];
const journey = [
  { img: 'journey-1-chai', n: 'I', title: 'A first conversation', text: 'Free and without obligation, by phone or over chai. You talk about your café; Deepak listens.', brief: 'Two cups of chai on a café table.' },
  { img: 'journey-2-entrance', n: 'II', title: 'Deepak visits', text: 'He sees your café during service, the way a guest would: the welcome, the wait, the bill, the goodbye.', brief: 'The café entrance seen from the street.' },
  { img: 'journey-3-plan', n: 'III', title: 'A plan and a quote', text: 'You agree the focus, the number of sessions and the fee together. Nothing starts until you are happy with it.', brief: 'A handwritten plan on a notebook page.' },
  { img: 'journey-4-session', n: 'IV', title: 'Morning sessions', text: 'In your café before you open, usually finishing before 12 or 1 PM depending on the café, so the team uses what they learned at lunch.', brief: 'A team practising at the counter before opening.' },
  { img: 'journey-5-lunch', n: 'V', title: 'A follow-up', text: 'Once the new habits have settled, Deepak checks what is working and adjusts the rest.', brief: 'A busy, well-run service at lunchtime.' },
];
const faqs = [
  { q: 'Is the first conversation really free?', a: 'Yes. The first conversation, on the phone or over a cup of chai, is free and comes with no obligation. It is a chance for Deepak to understand your café, and for you to decide whether the mentorship is right for you.' },
  { q: 'My team is only two people. Is this for me?', a: 'Very much. The mentorship is built for small, independent cafés. Training one or two people well often makes the biggest difference to how a guest feels.' },
  { q: 'Will the sessions get in the way of running my café?', a: 'Sessions are planned for the morning, before you open, and usually finish before 12 or 1 PM depending on your café. Your team learns first, then practises on real guests the same day.' },
  { q: 'What does it cost?', a: `The mentorship starts from ₹${price}. The final fee depends on your team size, the number of sessions and your location, and is agreed with you before anything begins.` },
  { q: 'We have not opened yet. Is it too early?', a: 'It is one of the best times. Habits are easier to build before the first guest walks in than to change afterwards. Deepak can help you plan service, roles and routines before opening day.' },
  { q: 'Can you guarantee more customers?', a: 'No, and be wary of anyone who does. What Deepak can promise is honest, practical work on the things guests notice: how they are welcomed, served and listened to. Those are the reasons people come back.' },
];
---
<Base title="Home" active="home" overlayHeader>
  <!-- 1. FULL-SCREEN FILM -->
  <Film film={films.lobby} size="full">
    <div class="hero">
      <p class="label in in-1">The Second Visit · Hospitality mentorship · {site.city}</p>
      <h1 class="hero__name" data-split="now">Deepak Thapliyal</h1>
      <p class="hero__line in in-3">Beautiful cafés win the first visit. <em>Hospitality wins the second.</em></p>
      <div class="hero__ctas in in-4">
        <a class="btn btn--light" href="#enquire">Book a consultation</a>
        <a class="link" href="#deepak">Meet Deepak</a>
      </div>
    </div>
    <a class="hero__cue" href="#deepak" aria-label="Scroll to the introduction"><span></span></a>
  </Film>

  <!-- 2. DEEPAK -->
  <section id="deepak" class="section intro" aria-labelledby="intro-h">
    <div class="container intro__grid">
      <div class="intro__photo">
        <Photo tag="Portrait of Deepak" ratio="4 / 5" alt="Portrait of Deepak Thapliyal in a café" brief="Deepak in a café before opening, in natural morning light. Looking at the room, not posed against a backdrop." sizes="(max-width: 900px) 100vw, 42vw" />
      </div>
      <div class="intro__text">
        <p class="label">Your mentor</p>
        <h2 id="intro-h" class="h2">Fifteen years in hospitality, <em>from the ground up</em>.</h2>
        <hr class="rule" />
        <p class="intro__lead">More than fifteen years in hospitality and management, learning how hotels, restaurants and cafés work from the ground up. Today he works in guest experience, listening to guests, identifying concerns and helping teams improve.</p>
        <p class="lead">Through <strong>The Second Visit</strong>, he now brings that experience to the café and restaurant owners of {site.city}, in their own cafés, in the morning, before service.</p>
        <dl class="facts">
          <div><dt class="label">Experience</dt><dd>15+ years</dd></div>
          <div><dt class="label">Range</dt><dd>Front &amp; back of house</dd></div>
          <div><dt class="label">Today</dt><dd>Guest experience</dd></div>
        </dl>
        <a class="link intro__more" href="/about/">His story</a>
      </div>
    </div>
  </section>

  <!-- 3. THE MENTORSHIP: hover reveal -->
  <section class="section section--ivory" aria-labelledby="m-h">
    <div class="container m-grid" data-reveal-list>
      <div class="m-left">
        <p class="label">The mentorship</p>
        <h2 id="m-h" class="h2">One mentorship, <em>shaped around your café</em>.</h2>
        <ol class="reveal-list__items">
          {areas.map((a, i) => (
            <li>
              <button class="area" type="button" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="area-preview" data-area={i}>
                <span class="area__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="area__body">
                  <span class="area__title">{a.title}</span>
                  <span class="area__text"><span>{a.text}</span></span>
                </span>
                <span class="area__tag">{a.tag}</span>
              </button>
            </li>
          ))}
        </ol>
      </div>
      <div class="m-right">
        <p class="lead">No fixed course and no slides. You choose the focus together, and Deepak works with you and your team on what matters most.</p>
        <div class="reveal-list__preview" id="area-preview" aria-live="polite">
          {areas.map((a, i) => (
            <div class:list={['reveal-list__frame', { 'is-active': i === 0 }]} data-frame={i}>
              <Photo src={photo(a.img)} tag={a.title} ratio="auto" alt={a.brief} brief={a.brief} sizes="(max-width: 900px) 0px, 40vw" />
            </div>
          ))}
        </div>
        <div class="price-row">
          <p><span class="label">From</span> <span class="price">₹<span set:html={price} /></span></p>
          <p class="muted small">Agreed with you after the first visit, before anything begins.</p>
          <a class="link" href="/mentorship/">The full mentorship</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. FILM: PHILOSOPHY -->
  <Film film={films.chai}>
    <p class="label">The philosophy</p>
    <blockquote class="film-quote">
      <p>“A café shouldn’t only attract people once. It should give them <em>a reason to return</em>.”</p>
    </blockquote>
    <p lang="hi" class="hindi film-hindi">अतिथि देवो भव</p>
  </Film>

  <!-- 5. THE JOURNEY: horizontal -->
  <section class="journey" aria-labelledby="journey-h" data-journey>
    <div class="journey__sticky">
      <div class="container journey__head">
        <div>
          <p class="label">A typical engagement</p>
          <h2 id="journey-h" class="h2" style="margin-top: 16px;">From the first chai <em>to the follow-up</em>.</h2>
        </div>
        <div class="journey__meta">
          <p class="muted small">The exact steps and the number of sessions are agreed with each café.</p>
          <div class="journey__bar" aria-hidden="true"><span data-journey-bar></span></div>
        </div>
      </div>
      <div class="journey__viewport" data-journey-viewport tabindex="0" role="region" aria-label="The five steps of a typical engagement. Scroll sideways to see them all.">
        <ol class="journey__track" data-journey-track>
          {journey.map((j) => (
            <li class="stop">
              <Photo src={photo(j.img)} class="stop__photo" tag={`Step ${j.n}`} ratio="4 / 3" alt={j.brief} brief={j.brief} sizes="(max-width: 900px) 80vw, 34vw" />
              <div class="stop__text">
                <span class="stop__n">{j.n}</span>
                <h3 class="h3">{j.title}</h3>
                <p>{j.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 6. BEFORE / AFTER -->
  <section class="section section--ivory" aria-labelledby="ba-h">
    <div class="container split ba-wrap" style="align-items: center;">
      <div style="flex: 1 1 360px;">
        <p class="label">The difference</p>
        <h2 id="ba-h" class="h2" style="margin-top: 16px;">The same café. <em>A different welcome.</em></h2>
        <p class="lead" style="margin-top: var(--gap);">Drag the line to compare. Nothing about the room changes; only how the guest is received.</p>
        <dl class="ba-key">
          <div><dt class="label">Before</dt><dd>The guest waits at the counter while staff finish another task.</dd></div>
          <div><dt class="label">After</dt><dd>A greeting within moments, eye contact, and a table offered.</dd></div>
        </dl>
      </div>
      <div class="ba-media" style="flex: 1.3 1 520px;">
        <Compare
          before={{ src: photo('compare-before'), alt: 'A guest waiting just inside the door while the team stays busy behind the counter', tag: 'Before', brief: 'Staged photograph: a guest waiting at the counter, staff busy with their backs turned.' }}
          after={{ src: photo('compare-after'), alt: 'A team member walking over to greet a guest with a smile', tag: 'After', brief: 'Same café, same angle: a team member greeting the guest with a smile, menu in hand.' }}
        />
      </div>
    </div>
  </section>

  <!-- 7. WHO IT'S FOR -->
  <section class="section" aria-labelledby="who-h">
    <div class="container split">
      <div style="flex: 1 1 380px;">
        <p class="label">Who it is for</p>
        <h2 id="who-h" class="h2" style="margin-top: 16px;">For owners who care <em>how it feels</em>.</h2>
      </div>
      <div style="flex: 1.3 1 520px;">
        <ul class="who__list">
          <li>You are planning a café and want to open with the right habits.</li>
          <li>Your café opened recently and you are still finding your rhythm.</li>
          <li>You run a small team, even just one or two people.</li>
          <li>You run a restaurant and want service to feel the same on every shift.</li>
        </ul>
        <p class="who__not"><strong>Not the right fit</strong> if you need interiors, menu design or social media, or if you want guaranteed numbers. Deepak won’t promise percentages.</p>
      </div>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="section section--ivory" aria-labelledby="faq-h">
    <div class="container split">
      <div style="flex: 1 1 320px;">
        <p class="label">Questions</p>
        <h2 id="faq-h" class="h2" style="margin-top: 16px;">What owners <em>usually ask</em>.</h2>
        <p style="margin-top: var(--gap);">Something else? Call or WhatsApp <a class="ulink" href={telHref()} set:html={phone} />.</p>
      </div>
      <div style="flex: 1.6 1 560px;">
        <Faq group="home-faq" items={faqs} />
      </div>
    </div>
  </section>

  <!-- 9. ENQUIRY -->
  <section id="enquire" class="section enquire" aria-labelledby="enq-h">
    <div class="container">
      <div class="enq-head">
        <div>
          <p class="label">Free first conversation</p>
          <h2 id="enq-h" class="h2" style="margin-top: 16px;">Begin with <em>a conversation</em>.</h2>
        </div>
        <div>
          <p class="lead enq-lead">Tell Deepak a little about your café. He will call you to arrange a first conversation, free and without obligation.</p>
          <dl class="contacts">
            <div><dt class="label">Call or WhatsApp</dt><dd><a href={telHref()} set:html={phone} /></dd></div>
            <div><dt class="label">Email</dt><dd><a href={mailHref()} set:html={phHtml(site.email, 'email address')} /></dd></div>
            <div><dt class="label">Based in</dt><dd>{site.city}, {site.region}</dd></div>
          </dl>
        </div>
      </div>
      <div class="enq-body">
        <EnquiryForm id="home" wide />
      </div>
    </div>
  </section>
</Base>

<style>
  /* hero */
  .hero { text-align: center; max-width: 1100px; margin-inline: auto; }
  .hero__name { margin-top: var(--gap); font-family: var(--font-display); font-weight: 400; color: var(--on-dark); font-size: clamp(48px, min(10.4vw, 17svh), 168px); line-height: 0.95; letter-spacing: -0.015em; text-wrap: balance; }
  .hero__line { margin: var(--gap) auto 0; max-width: 30ch; font-family: var(--font-display); font-size: clamp(22px, 2.3vw, 32px); line-height: 1.3; color: var(--on-dark); }
  .hero__line em { color: var(--gold-soft); }
  .hero__ctas { margin-top: clamp(20px, 5svh, 44px); display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 20px 36px; }
  .hero__cue { position: absolute; left: 50%; bottom: 28px; width: 44px; height: 64px; margin-left: -22px; display: flex; justify-content: center; }
  .hero__cue span { display: block; width: 1px; height: 100%; background: linear-gradient(rgba(244,240,233,0), rgba(244,240,233,.8)); }
  @media (prefers-reduced-motion: no-preference) {
    .hero__cue span { transform-origin: top; animation: cue 2.4s var(--ease) infinite; }
    @keyframes cue { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }
  }

  /* intro */
  .intro__grid { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(40px, 5vw, 88px); align-items: center; }
  .intro__photo :global(.photo) { height: min(calc(var(--screen) - 2 * var(--section)), 600px, 46vw); width: auto; aspect-ratio: 4 / 5; }
  .intro__text .h2 { margin-top: 16px; }
  .intro__text .rule { margin-top: var(--gap); }
  .intro__lead { margin-top: var(--gap); font-size: clamp(16px, min(1.4vw, 2.4svh), 19px); line-height: 1.55; color: var(--ink); max-width: 34em; }
  .intro__text .lead { margin-top: 12px; }
  .facts { margin-top: var(--gap); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .facts div { padding: 14px 16px 0 0; }
  .facts dd { margin-top: 6px; font-family: var(--font-display); font-size: clamp(17px, min(1.6vw, 2.8svh), 22px); line-height: 1.25; color: var(--ink); }
  .intro__more { margin-top: var(--gap); }
  @media (max-width: 899px) {
    .intro__grid { grid-template-columns: 1fr; gap: 20px; }
    .intro__photo :global(.photo) { width: 100%; height: auto; aspect-ratio: 16 / 10 !important; max-height: 17svh; }
    .intro__photo :global(.photo__brief) { font-size: 15px; }
    .intro__text .rule { display: none; }
    .intro__lead { margin-top: 14px; font-size: 16px; }
    .facts { margin-top: 14px; }
    .facts div { padding-top: 10px; }
    .intro__more { margin-top: 10px; }
    .intro__text .lead { font-size: 15px; }
    .facts dd { font-size: 16px; }
    .facts .label { font-size: 10px; letter-spacing: .18em; }
  }

  /* mentorship hover reveal */
  .m-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); }
  .m-left .h2 { margin-top: 16px; }
  .m-right { display: flex; flex-direction: column; gap: var(--gap); }
  .reveal-list__items { margin-top: var(--gap); border-top: 1px solid var(--line-strong); }
  .reveal-list__items li { border-bottom: 1px solid var(--line-strong); }
  .area { width: 100%; display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; gap: 12px; align-items: baseline; padding: clamp(10px, 1.7svh, 18px) 0; border: 0; background: none; text-align: left; cursor: pointer; color: var(--ink); }
  .area__num { font-family: var(--font-ui); font-size: 12px; letter-spacing: 0.2em; color: var(--muted); transition: color .3s ease; }
  .area__tag { font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .area__title { display: block; font-family: var(--font-display); font-size: clamp(20px, min(2.1vw, 3.4svh), 28px); line-height: 1.2; transition: transform .5s var(--ease), color .3s ease; }
  .area__text > span { min-height: 0; overflow: hidden; }
  .area__text { display: grid; grid-template-rows: 0fr; overflow: hidden; margin-top: 0; font-size: 15px; line-height: 1.55; color: var(--body); opacity: 0; transition: grid-template-rows .5s var(--ease), opacity .4s ease, margin-top .5s var(--ease); }
  .area[aria-pressed='true'] .area__num, .area[aria-pressed='true'] .area__tag { color: var(--gold); }
  .area[aria-pressed='true'] .area__title { transform: translateX(6px); }
  .area[aria-pressed='true'] .area__text { grid-template-rows: 1fr; opacity: 1; margin-top: 6px; }
  .area:hover .area__title { color: var(--gold); }
  .area:focus-visible { outline-offset: -2px; }
  .reveal-list__preview { position: relative; flex: 1 1 auto; min-height: 200px; }
  .reveal-list__frame { position: absolute; inset: 0; opacity: 0; transform: scale(1.03); transition: opacity .6s ease, transform 1.2s var(--ease); }
  .reveal-list__frame.is-active { opacity: 1; transform: none; }
  .reveal-list__frame :global(.photo) { height: 100%; }
  .price-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 24px; }
  .price-row .small { flex: 1 1 100%; order: 3; }
  .price { font-family: var(--font-display); font-size: clamp(28px, min(3vw, 4.6svh), 40px); color: var(--ink); margin-left: 10px; }
  @media (max-width: 899px) {
    .m-grid { grid-template-columns: 1fr; gap: 16px; }
    .m-right { display: contents; }
    .m-left { display: contents; }
    .m-left .label { order: 1; } .m-left .h2 { order: 2; margin-top: 0; }
    .m-right .lead { order: 3; font-size: 15px; }
    .reveal-list__items { order: 4; }
    .price-row { order: 5; }
    .reveal-list__preview { display: none; }
    .reveal-list__items { margin-top: 0; }
    .area__title { font-size: 18px; }
    .area { padding: 9px 0; }
    .area__tag { display: none; }
    .price-row { justify-content: space-between; align-items: center; }
    .price { font-size: 26px; }
    .price-row .small { font-size: 13px; }
  }

  /* film quote */
  .film-quote em { color: var(--gold-soft); }
  .film-quote p { margin: 32px auto 0; max-width: 21ch; font-family: var(--font-display); font-weight: 400; font-size: clamp(36px, 4.8vw, 70px); line-height: 1.12; color: var(--on-dark); text-wrap: balance; }
  .film-hindi { margin-top: 36px; font-size: 22px; color: var(--gold-soft); }

  /* journey */
  .journey { position: relative; background: var(--white); }
  .journey__sticky { padding-block: var(--section); }
  .journey__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px 64px; }
  .journey__head > div:first-child { flex: 1 1 520px; }
  .journey__meta { flex: 0 1 320px; }
  .journey__bar { margin-top: 18px; height: 1px; background: var(--line-strong); }
  .journey__bar span { display: block; height: 100%; width: 100%; background: var(--ink); transform: scaleX(var(--p, 0)); transform-origin: left; }
  .journey__viewport { margin-top: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter))); scroll-padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter))); }
  .journey__viewport::-webkit-scrollbar { display: none; }
  .journey__track { display: flex; gap: clamp(24px, 3vw, 48px); width: max-content; }
  .stop { width: min(78vw, 440px); scroll-snap-align: start; }
  @media (min-width: 900px) { .stop :global(.stop__photo) { aspect-ratio: auto !important; height: clamp(140px, calc(var(--screen) - 470px), 330px); } }
  @media (max-width: 899px) { .journey__meta { display: none; } }
  .stop__text { margin-top: 16px; display: grid; grid-template-columns: 56px minmax(0, 1fr); column-gap: 12px; }
  .stop__n { grid-row: span 2; font-family: var(--font-display); font-size: 34px; line-height: 1; color: var(--gold); }
  .stop p { margin-top: 6px; font-size: 15px; line-height: 1.55; }
  /* Scroll-driven horizontal mode (desktop, motion allowed): set by script */
  .journey.is-pinned { height: var(--journey-h, 300vh); }
  .journey.is-pinned .journey__sticky { position: sticky; top: 0; height: 100vh; height: 100svh; display: flex; flex-direction: column; justify-content: center; overflow: hidden; padding-block: 72px 0; }
  .journey.is-pinned .journey__viewport { overflow: visible; scroll-snap-type: none; }
  .journey.is-pinned .journey__track { transform: translate3d(calc(var(--x, 0) * -1px), 0, 0); will-change: transform; }

  /* before / after key */
  .ba-key { margin-top: var(--gap); display: grid; gap: 12px; }
  .ba-key dd { font-size: 15px; line-height: 1.5; }
  .ba-media :global(.cmp) { max-height: calc(var(--screen) - 2 * var(--section)); width: 100%; }
  @media (max-width: 899px) { .ba-wrap { gap: 20px; } .ba-key { grid-template-columns: 1fr 1fr; gap: 16px; } }
  .ba-key div { border-top: 1px solid var(--line-strong); padding-top: 10px; }
  .ba-key dd { margin-top: 6px; }

  /* who */
  .who__list li { padding: clamp(10px, 2svh, 20px) 0 clamp(10px, 2svh, 20px) 36px; border-top: 1px solid var(--line-strong); position: relative; font-size: clamp(16px, 2.4svh, 18px); line-height: 1.5; color: var(--ink); }
  .who__list li::before { content: ""; position: absolute; left: 0; top: calc(clamp(10px, 2svh, 20px) + .75em); width: 18px; height: 1px; background: var(--gold); }
  .who__not { margin-top: var(--gap); padding-top: var(--gap); border-top: 1px solid var(--line-strong); font-size: 16px; }

  /* enquiry */
  .enq-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 16px clamp(40px, 6vw, 96px); align-items: end; }
  .contacts { margin-top: var(--gap); display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 8px clamp(20px, 3vw, 40px); }
  .contacts dd { margin-top: 2px; font-family: var(--font-display); font-size: clamp(17px, 2.6svh, 21px); color: var(--ink); }
  .contacts a { text-decoration: none; }
  .enq-body { margin-top: clamp(20px, 4svh, 48px); padding-top: clamp(20px, 4svh, 48px); border-top: 1px solid var(--line); }
  @media (max-width: 899px) { .enq-head { grid-template-columns: 1fr; } .contacts, .enq-lead { display: none; } .enq-body { margin-top: 16px; padding-top: 0; border: 0; } }
</style>

<script>
  // Mentorship hover reveal: hovering, focusing or tapping an area shows its picture.
  document.querySelectorAll<HTMLElement>('[data-reveal-list]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-area]'));
    const frames = Array.from(root.querySelectorAll<HTMLElement>('[data-frame]'));
    const show = (i: number) => {
      buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
      frames.forEach((f, j) => f.classList.toggle('is-active', i === j));
    };
    const canHover = window.matchMedia('(hover: hover)').matches;
    buttons.forEach((b, i) => {
      b.addEventListener('click', () => show(i));
      b.addEventListener('focus', () => show(i));
      if (canHover) b.addEventListener('mouseenter', () => show(i));
    });
  });

  // Journey: on wide screens, vertical scrolling moves the steps sideways.
  // Elsewhere (phones, reduced motion) it is a normal swipeable row.
  document.querySelectorAll<HTMLElement>('[data-journey]').forEach((section) => {
    const viewport = section.querySelector<HTMLElement>('[data-journey-viewport]')!;
    const track = section.querySelector<HTMLElement>('[data-journey-track]')!;
    const bar = section.querySelector<HTMLElement>('[data-journey-bar]')!;
    const wide = window.matchMedia('(min-width: 900px) and (prefers-reduced-motion: no-preference)');
    let distance = 0;

    const measure = () => {
      if (!wide.matches) {
        section.classList.remove('is-pinned');
        section.style.removeProperty('--journey-h');
        track.style.removeProperty('--x');
        return;
      }
      section.classList.add('is-pinned');
      const pad = parseFloat(getComputedStyle(viewport).paddingLeft) || 0;
      distance = Math.max(0, track.scrollWidth + pad * 2 - window.innerWidth);
      section.style.setProperty('--journey-h', `${window.innerHeight + distance}px`);
      update();
    };
    const update = () => {
      if (section.classList.contains('is-pinned')) {
        const top = section.getBoundingClientRect().top;
        const p = distance ? Math.min(1, Math.max(0, -top / distance)) : 0;
        track.style.setProperty('--x', String(Math.round(p * distance)));
        bar.style.setProperty('--p', p.toFixed(3));
      } else {
        const max = viewport.scrollWidth - viewport.clientWidth;
        bar.style.setProperty('--p', max > 0 ? (viewport.scrollLeft / max).toFixed(3) : '0');
      }
    };
    let ticking = false;
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { update(); ticking = false; }); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    viewport.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', measure);
    wide.addEventListener('change', measure);
    if (document.fonts?.ready) document.fonts.ready.then(measure);
    measure();
  });
</script>
