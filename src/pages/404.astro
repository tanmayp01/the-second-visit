---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex mobileBar={false}>
  <section class="nf">
    <div class="container narrow center">
      <p class="label">Page not found</p>
      <h1 class="h1 nf__h">We couldn’t find <em>that table</em>.</h1>
      <p class="lead" style="margin: 32px auto 0;">The page you were looking for has moved or never existed.</p>
      <div class="nf__btns">
        <a class="btn btn--solid" href="/">Return home</a>
        <a class="link" href="/contact/">Contact Deepak</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(96px, 14vw, 200px); }
  .nf__h { margin-top: 28px; font-size: clamp(48px, 6vw, 88px); }
  .nf__btns { margin-top: 48px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 24px 40px; }
</style>
