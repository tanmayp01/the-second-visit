---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Side = { src?: ImageMetadata; tag: string; brief: string; alt?: string };
interface Props { before: Side; after: Side; ratio?: string }
const { before, after, ratio = '4 / 3' } = Astro.props;
const id = `cmp-${Math.random().toString(36).slice(2, 8)}`;
---
<figure class="cmp" data-compare style={`--pos: 50%; aspect-ratio: ${ratio};`}>
  <div class="cmp__layer cmp__before">
    {before.src
      ? <Image src={before.src} alt={before.alt ?? before.tag} widths={[600, 1000, 1400]} sizes="(max-width: 900px) 100vw, 55vw" />
      : <div class="cmp__ph"><span class="cmp__tag">{before.tag} · placeholder</span><p>{before.brief}</p></div>}
  </div>
  <div class="cmp__layer cmp__after" aria-hidden="true">
    {after.src
      ? <Image src={after.src} alt="" widths={[600, 1000, 1400]} sizes="(max-width: 900px) 100vw, 55vw" />
      : <div class="cmp__ph cmp__ph--after"><span class="cmp__tag">{after.tag} · placeholder</span><p>{after.brief}</p></div>}
  </div>
  <div class="cmp__handle" aria-hidden="true"><span class="cmp__knob"><svg width="22" height="10" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M5 1L1 5l4 4M17 1l4 4-4 4" /></svg></span></div>
  <span class="cmp__label cmp__label--l" aria-hidden="true">Before</span>
  <span class="cmp__label cmp__label--r" aria-hidden="true">After</span>
  <label class="sr-only" for={id}>Compare before and after. Move right to show more of the before picture.</label>
  <input class="cmp__range" id={id} type="range" min="0" max="100" value="50" step="1" data-compare-range />
  {after.src && <figcaption class="sr-only">{after.alt ?? after.tag}</figcaption>}
</figure>

<style>
  .cmp { position: relative; margin: 0; overflow: hidden; user-select: none; -webkit-user-select: none; touch-action: pan-y; max-width: 100%; background: var(--ivory); }
  .cmp__layer { position: absolute; inset: 0; }
  .cmp__layer :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .cmp__after { clip-path: inset(0 0 0 var(--pos)); }
  .cmp__ph { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(20px, 3vw, 36px); background: #DCD5CA; color: var(--body); }
  .cmp__ph--after { background: #EFE9DF; align-items: flex-end; text-align: right; }
  .cmp__ph p { max-width: min(26ch, 40%); font-family: var(--font-display); font-size: clamp(17px, 1.5vw, 21px); line-height: 1.4; }
  .cmp__tag { position: absolute; top: clamp(20px, 3vw, 32px); font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); }
  .cmp__ph:not(.cmp__ph--after) .cmp__tag { left: clamp(20px, 3vw, 36px); }
  .cmp__ph--after .cmp__tag { right: clamp(20px, 3vw, 36px); }
  .cmp__ph { padding-bottom: 64px; }
  @media (max-width: 599px) {
    .cmp { aspect-ratio: 4 / 3 !important; }
    .cmp__tag { display: none; }
    .cmp__ph { justify-content: flex-start; padding-top: 20px; }
    .cmp__ph p { font-size: 15px; max-width: 42%; }
  }
  .cmp__handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 1px; margin-left: -0.5px; background: var(--white); box-shadow: 0 0 0 0.5px rgba(22,20,18,.25); pointer-events: none; }
  .cmp__knob { position: absolute; top: 50%; left: 50%; width: 52px; height: 52px; margin: -26px 0 0 -26px; display: grid; place-items: center; background: var(--white); color: var(--ink); border: 1px solid var(--line-strong); transition: transform .3s var(--ease); }
  .cmp:hover .cmp__knob, .cmp__range:focus-visible ~ .cmp__handle .cmp__knob { transform: scale(1.08); }
  .cmp__label { position: absolute; bottom: 16px; padding: 6px 10px; background: rgba(255,255,255,.88); font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink); pointer-events: none; }
  .cmp__label--l { left: 16px; } .cmp__label--r { right: 16px; }
  .cmp__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; touch-action: pan-y; pointer-events: none; }
  .cmp { cursor: ew-resize; }
  .cmp:has(.cmp__range:focus-visible) { outline: 2px solid var(--gold); outline-offset: 4px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((fig) => {
    const range = fig.querySelector<HTMLInputElement>('[data-compare-range]')!;
    const set = (v: number) => fig.style.setProperty('--pos', `${Math.min(100, Math.max(0, v))}%`);
    range.addEventListener('input', () => set(Number(range.value)));
    // Drag anywhere on the picture. Vertical swipes still scroll the page on touch screens.
    const fromPointer = (e: PointerEvent) => {
      const r = fig.getBoundingClientRect();
      range.value = String(Math.round(((e.clientX - r.left) / r.width) * 100));
      set(Number(range.value));
    };
    let dragging = false;
    fig.addEventListener('pointerdown', (e) => { dragging = true; fig.setPointerCapture(e.pointerId); fromPointer(e); });
    fig.addEventListener('pointermove', (e) => { if (dragging) fromPointer(e); });
    const stop = () => { dragging = false; };
    fig.addEventListener('pointerup', stop);
    fig.addEventListener('pointercancel', stop);
    set(Number(range.value));
  });
</script>
