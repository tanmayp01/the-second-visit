---
import { site, telHref, mailHref, phHtml } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="footer dark">
  <div class="container">
    <div class="footer__top">
      <p class="footer__line">A reason to return.</p>
      <a class="btn btn--light" href="/contact/">Book a consultation</a>
    </div>
    <div class="footer__grid">
      <div class="footer__brand">
        <p class="footer__name">The Second Visit</p>
        <p class="footer__by">by {site.owner}</p>
        <p class="footer__text">Hospitality mentorship for cafés and restaurants in {site.city}, {site.region}.</p>
      </div>
      <nav aria-label="Footer" class="footer__col">
        <p class="label">Explore</p>
        <a href="/">Home</a>
        <a href="/about/">About Deepak</a>
        <a href="/mentorship/">The mentorship</a>
        <a href="/contact/">Contact</a>
      </nav>
      <div class="footer__col">
        <p class="label">Contact</p>
        <a href={telHref()} set:html={phHtml(site.phoneDisplay, '+91 XXXXX XXXXX')} />
        <a href={mailHref()} set:html={phHtml(site.email, 'email address')} />
        <a href={site.instagram?.url ?? '/contact/'}>Instagram</a>
        <a href={site.linkedin?.url ?? '/contact/'}>LinkedIn</a>
      </div>
      <div class="footer__col">
        <p class="label">Visit</p>
        <p>{site.city}, {site.region}</p>
        <p class="footer__muted">Other cities by arrangement</p>
        <p lang="hi" class="hindi footer__hindi">अतिथि देवो भव</p>
      </div>
    </div>
    <div class="footer__bottom">
      <span>© {year} {site.name}</span>
      <span>Designed by {site.agency.url ? <a href={site.agency.url}>{site.agency.name}</a> : site.agency.name}</span>
    </div>
  </div>
</footer>

<style>
  .footer { padding: clamp(80px, 9vw, 128px) 0 36px; font-size: 15px; }
  .footer a { color: var(--on-dark); text-decoration: none; display: block; padding-block: 5px; transition: color .2s ease; }
  .footer a:hover { color: var(--gold-soft); }
  .footer__top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px; padding-bottom: clamp(56px, 6vw, 88px); border-bottom: 1px solid rgba(244,240,233,.14); }
  .footer__top .btn { display: inline-flex; padding-block: 0; }
  .footer__line { font-family: var(--font-display); font-weight: 300; font-style: italic; font-size: clamp(44px, 6vw, 88px); line-height: 1; color: var(--on-dark); }
  .footer__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 48px 32px; padding-block: clamp(56px, 6vw, 80px); }
  .footer__name { font-family: var(--font-display); font-size: 22px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--on-dark); }
  .footer__by { margin-top: 6px; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--gold-soft); }
  .footer__text { margin-top: 20px; max-width: 30ch; }
  .footer__col { display: flex; flex-direction: column; gap: 2px; }
  .footer__col .label { margin-bottom: 14px; }
  .footer__col p:not(.label) { padding-block: 5px; color: var(--on-dark); }
  .footer__col p.footer__muted { color: var(--on-dark-muted); }
  .footer__hindi { margin-top: 10px; font-size: 18px; color: var(--gold-soft) !important; }
  .footer__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-top: 28px; border-top: 1px solid rgba(244,240,233,.14); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
  .footer__bottom a { display: inline; padding: 0; text-decoration: underline; text-underline-offset: 4px; }
</style>
