---
interface Props {
  name: 'arrow' | 'phone' | 'chat' | 'mail' | 'instagram' | 'linkedin' | 'check' | 'x' | 'menu' | 'chevron' | 'bell' | 'alert';
  size?: number;
  stroke?: number;
  class?: string;
}
const { name, size = 18, stroke, class: cls } = Astro.props;
const w = stroke ?? (['arrow', 'menu', 'x', 'chevron'].includes(name) ? 2 : name === 'check' ? 2.2 : 1.8);
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={w} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow' && <><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></>}
  {name === 'phone' && <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />}
  {name === 'chat' && <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />}
  {name === 'mail' && <><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M22 6l-10 7L2 6" /></>}
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.5 6.5h.01" /></>}
  {name === 'linkedin' && <><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" /></>}
  {name === 'check' && <path d="M20 6L9 17l-5-5" />}
  {name === 'x' && <><path d="M6 6l12 12" /><path d="M18 6L6 18" /></>}
  {name === 'menu' && <><path d="M4 8h16" /><path d="M4 16h16" /></>}
  {name === 'chevron' && <path d="M6 9l6 6 6-6" />}
  {name === 'bell' && <><path d="M12 5.5v2" /><path d="M10.2 5h3.6" /><path d="M4 17a8 8 0 0 1 16 0" /><path d="M2 17h20" /><path d="M3 20h18" /></>}
  {name === 'alert' && <><circle cx="12" cy="12" r="9" /><path d="M12 8v5" /><path d="M12 16.5v.01" /></>}
</svg>
