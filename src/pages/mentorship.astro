---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Film from '../components/Film.astro';
import Faq from '../components/Faq.astro';
import { site, phHtml } from '../config/site';
import { films } from '../config/media';

const price = phHtml(site.priceFrom, 'X,XXX');

const groups = [
  { label: 'The guest', title: 'How guests feel', items: [
    ['The welcome', 'Greeting, seating, serving and seeing guests off.'],
    ['Talking with guests', 'Warm, confident conversation; knowing your regulars.'],
    ['Feedback and complaints', 'Asking, listening and recovering well.'],
    ['Bringing guests back', 'The honest habits that build loyalty.'],
  ] },
  { label: 'The team', title: 'How your team serves', items: [
    ['Staff training', 'Practical coaching, even for one or two people.'],
    ['Service standards', 'Simple rules everyone follows, every shift.'],
    ['On the floor', 'Body language, tone, and handling a rush.'],
    ['Lasting habits', 'Working practices that stay after the sessions end.'],
  ] },
  { label: 'The operation', title: 'How the café runs', items: [
    ['Stock and inventory', 'Ordering, stock checks and cutting waste.'],
    ['Workflows', 'Opening, closing and service routines.'],
    ['Tools and software', 'Getting real use from the systems you already have.'],
    ['Pre-opening', 'Roles, routines and service plans for new cafés.'],
  ] },
];
const who = [
  ['The owner', 'One-to-one mentorship on the decisions only an owner makes: standards, stock, hiring for attitude, and how to lead a shift.'],
  ['The team', 'Hands-on training for your staff, however few, on welcoming guests, handling feedback and working as one team.'],
  ['Owner and team together', 'Everyone hears the same thing, agrees the same standard, and practises it together before the doors open.'],
];
const flow = [
  ['I', 'A first conversation', 'Free and without obligation, by phone or in person, about your café, your team and what is on your mind.'],
  ['II', 'Seeing your service', 'Deepak visits during working hours and experiences your café as a guest would: the welcome, the wait, the bill, the goodbye.'],
  ['III', 'A plan and a quote', 'You agree the focus, the number of sessions and the fee together. Nothing starts until you are happy with it.'],
  ['IV', 'Morning sessions', 'In your café, before you open, usually finishing before 12 or 1 PM depending on the café, so the team uses what they learned at lunch.'],
  ['V', 'A follow-up', 'A check-in once the habits have had time to settle, to see what is working and adjust what isn’t.'],
];
// Set to true once Deepak confirms the session language answer.
const languageConfirmed = false;
const allFaqs = [
  { q: 'Where do the sessions happen?', a: 'In your own café or restaurant, so the training uses your counter, your menu and your floor. That is what makes it stick.' },
  { q: 'How many sessions will we need?', a: 'It depends on your café and what you want to work on. Deepak will suggest a number after he has seen your service, and you decide together.' },
  { q: 'What language are sessions in?', a: 'Hindi, English or a mix, whatever your team is most comfortable with.' },
  { q: 'Do you work outside Dehradun?', a: 'Dehradun is home. On-site mentorship in other cities is possible for suitable engagements, subject to travel, availability and terms agreed together.' },
  { q: 'Does my team need to prepare anything?', a: 'No. Just come in as you normally would before a shift. Sessions are practical and done on the floor, not on paper.' },
];
const faqs = allFaqs.filter((f) => languageConfirmed || !f.q.startsWith('What language'));
---
<Base title="The mentorship" description="One hospitality mentorship, shaped around your café: guest experience, staff training, feedback and stock, on-site in Dehradun, in the morning before service." active="mentorship">
  <section class="m-hero" aria-labelledby="m-h">
    <div class="container center narrow">
      <p class="label in in-1">The mentorship</p>
      <h1 id="m-h" class="h1 in in-2">Built around your café, <em>not a syllabus</em>.</h1>
      <p class="lead in in-3" style="margin: 36px auto 0;">Deepak sees how your café works, agrees the focus with you, and trains you and your team on-site, in the morning, before service.</p>
      <div class="in in-4 m-hero__cta">
        <a class="btn btn--solid" href="/contact/">Book a consultation <Icon name="arrow" size={16} stroke={1.5} /></a>
      </div>
    </div>
    <div class="container m-hero__photo">
      <Photo class="unveil" tag="Morning session" ratio="21 / 9" alt="A morning session in progress with a small café team" brief="Deepak and a two-person café team at a table before opening, chai and notebooks out, chairs still stacked behind them." sizes="(max-width: 1280px) 100vw, 1280px" />
    </div>
  </section>

  <section class="section section--ivory" aria-labelledby="menu-h">
    <div class="container">
      <div class="split" style="align-items: flex-end;">
        <div style="flex: 1 1 420px;">
          <p class="label">What we work on</p>
          <h2 id="menu-h" class="h2" style="margin-top: 24px;">Choose what matters most <em>to your café</em>.</h2>
        </div>
        <p class="lead" style="flex: 1 1 380px;">You choose the focus together. Deepak recommends where to start once he has seen your service.</p>
      </div>
      <div class="groups">
        {groups.map((g) => (
          <div class="group reveal">
            <p class="label">{g.label}</p>
            <h3 class="h3">{g.title}</h3>
            <dl>{g.items.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}</dl>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="who-h">
    <div class="container">
      <p class="label">Who takes part</p>
      <h2 id="who-h" class="h2" style="margin-top: 24px;">You, your team, <em>or both</em>.</h2>
      <div class="who">
        {who.map(([t, d]) => <div class="reveal"><h3 class="h3">{t}</h3><p>{d}</p></div>)}
      </div>
    </div>
  </section>

  <Film film={films.kitchen} size="medium">
    <p class="label">The format</p>
    <h2 class="h2 film-h">Learned in the morning. <em>Served by noon.</em></h2>
    <p class="film-p">Every session takes place in your own café before the doors open.</p>
  </Film>

  <section class="section" aria-labelledby="flow-h">
    <div class="container split">
      <div style="flex: 1 1 340px;">
        <p class="label">A typical engagement</p>
        <h2 id="flow-h" class="h2" style="margin-top: 24px;">From the first chai <em>to the follow-up</em>.</h2>
        <p class="muted" style="margin-top: 24px;">The exact steps and the number of sessions are agreed with each café.</p>
      </div>
      <ol class="flow" style="flex: 1.6 1 560px;">
        {flow.map(([n, t, d]) => <li class="reveal"><span class="flow__n">{n}</span><div><h3 class="h3">{t}</h3><p>{d}</p></div></li>)}
      </ol>
    </div>
  </section>

  <section class="section section--ivory" aria-labelledby="fee-h">
    <div class="container center narrow">
      <p class="label">Fees</p>
      <h2 id="fee-h" class="h2" style="margin-top: 24px;">Clear pricing, <em>agreed up front</em>.</h2>
      <p class="fee"><span class="label">From</span> ₹<span set:html={price} /></p>
      <p class="lead" style="margin: 0 auto;">The first conversation is always free. The fee depends on your team size, the number of sessions and your location, and you receive a clear quote before anything begins.</p>
      <a class="btn btn--line" href="/contact/" style="margin-top: 44px;">Ask for a quote</a>
    </div>
  </section>

  <section class="section" aria-labelledby="mfaq-h">
    <div class="container split">
      <div style="flex: 1 1 320px;">
        <p class="label">Practical details</p>
        <h2 id="mfaq-h" class="h2" style="margin-top: 24px;">Logistics, <em>answered</em>.</h2>
      </div>
      <div style="flex: 1.6 1 560px;">
        <Faq group="m-faq" items={faqs} />
      </div>
    </div>
  </section>
</Base>

<style>
  .m-hero { padding: clamp(40px, 6vw, 96px) 0 clamp(72px, 9vw, 140px); }
  .m-hero .h1 { margin-top: 28px; }
  .m-hero__cta { margin-top: 44px; }
  .m-hero__photo { margin-top: clamp(56px, 7vw, 96px); }
  @media (max-width: 899px) { .m-hero__photo :global(.photo) { aspect-ratio: 4 / 3 !important; } }
  .groups { margin-top: clamp(56px, 7vw, 96px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 32px; }
  .group { background: var(--white); padding: clamp(32px, 3.5vw, 48px); }
  .group .h3 { margin-top: 16px; }
  .group dl { margin-top: 28px; }
  .group dl div { padding: 16px 0; border-top: 1px solid var(--line); }
  .group dt { color: var(--ink); font-weight: 450; }
  .group dd { margin-top: 4px; font-size: 15px; }
  .who { margin-top: clamp(48px, 6vw, 80px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 48px; }
  .who div { border-top: 1px solid var(--ink); padding-top: 28px; }
  .who p { margin-top: 14px; font-size: 16px; }
  .film-h { margin-top: 24px; color: var(--on-dark) !important; }
  .film-p { margin: 24px auto 0; max-width: 34em; font-size: 18px; color: var(--on-dark); }
  .flow li { display: grid; grid-template-columns: 64px 1fr; gap: 16px; padding: 28px 0; border-top: 1px solid var(--line); }
  .flow li:last-child { border-bottom: 1px solid var(--line); }
  .flow__n { font-family: var(--font-display); font-style: italic; font-size: 30px; line-height: 1; color: var(--gold); }
  .flow p { margin-top: 10px; font-size: 16px; max-width: 52ch; }
  .fee { margin: 44px 0 32px; font-family: var(--font-display); font-weight: 300; font-size: clamp(56px, 7vw, 96px); line-height: 1; color: var(--ink); }
  .fee .label { display: block; margin-bottom: 16px; }
</style>
