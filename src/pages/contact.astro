---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site, telHref, waHref, mailHref, phHtml } from '../config/site';
---
<Base title="Contact" description="Book a free, no-obligation conversation with Deepak Thapliyal about your café or restaurant in Dehradun." active="contact" mobileBar={false}>
  <section class="c-page" aria-labelledby="c-h">
    <div class="container">
      <div class="c-side">
        <div>
          <p class="label in in-1">Contact</p>
          <h1 id="c-h" class="h1 in in-2">Begin with <em>a conversation</em>.</h1>
        </div>
        <div>
          <p class="lead in in-3">Tell Deepak a little about your café. The first conversation is free, and there is nothing to prepare or sign.</p>
          <a class="link in in-4 c-skip" href="#reach">Other ways to reach Deepak</a>
        </div>
      </div>
      <div class="c-form">
        <EnquiryForm id="contact" wide />
      </div>
    </div>
  </section>

  <section id="reach" class="section section--ivory" aria-labelledby="reach-h">
    <div class="container split">
      <div style="flex: 1 1 360px;">
        <p class="label">What happens next</p>
        <h2 id="reach-h" class="h2" style="margin-top: 16px;">Simple, <em>and personal</em>.</h2>
        <ol class="next">
          <li><span>I</span><p>Deepak calls or messages you within <span set:html={phHtml(site.replyDays, 'X')} /> working days.</p></li>
          <li><span>II</span><p>You talk about your café, over the phone or over chai.</p></li>
          <li><span>III</span><p>If it is a good fit, he suggests a plan and a clear quote.</p></li>
        </ol>
      </div>
      <dl class="contacts" style="flex: 1.2 1 480px;">
        <div>
          <dt class="label">Call or WhatsApp</dt>
          <dd><a href={telHref()} set:html={phHtml(site.phoneDisplay, '+91 XXXXX XXXXX')} /></dd>
          <dd class="contacts__more">
            <a class="link" href={waHref()} target={site.phoneE164 ? '_blank' : undefined} rel={site.phoneE164 ? 'noopener' : undefined}><Icon name="chat" size={15} /> WhatsApp</a>
            <span class="muted small">Best time: <span set:html={phHtml(site.bestTimeToCall, 'e.g. 3 to 6 PM, Mon to Sat')} /></span>
          </dd>
        </div>
        <div><dt class="label">Email</dt><dd><a href={mailHref()} set:html={phHtml(site.email, 'email address')} /></dd></div>
        <div><dt class="label">Social</dt><dd class="contacts__social"><a href={site.instagram?.url ?? '#'}>Instagram</a><a href={site.linkedin?.url ?? '#'}>LinkedIn</a></dd></div>
        <div><dt class="label">Based in</dt><dd>{site.city}, {site.region}</dd></div>
      </dl>
    </div>
  </section>
</Base>

<style>
  .c-page { padding: clamp(8px, 2svh, 40px) 0 clamp(12px, 4svh, 96px); }
  .c-side { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 16px clamp(40px, 6vw, 96px); align-items: end; }
  .c-side .h1 { margin-top: 12px; font-size: clamp(34px, min(5vw, 7svh), 76px); }
  .c-skip { margin-top: 12px; }
  .c-form { margin-top: clamp(12px, 2.5svh, 40px); background: var(--ivory); padding: clamp(16px, min(3.5vw, 3.4svh), 44px); }
  @media (max-width: 899px) { .c-side { grid-template-columns: 1fr; } .c-side .lead, .c-skip { display: none; } .c-form { margin-inline: calc(var(--gutter) * -1); margin-top: 12px; } .c-page { padding-bottom: 0; } }
  .next { margin-top: var(--gap); border-top: 1px solid var(--line-strong); }
  .next li { display: flex; gap: 20px; padding: clamp(10px, 2svh, 18px) 0; border-bottom: 1px solid var(--line-strong); font-size: 16px; line-height: 1.5; }
  .next li > span:first-child { flex: none; width: 28px; font-family: var(--font-display); font-size: 22px; line-height: 1.2; color: var(--gold); }
  .contacts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: clamp(16px, 3svh, 32px); align-content: center; }
  .contacts dd { margin-top: 4px; font-family: var(--font-display); font-size: clamp(19px, 3svh, 23px); color: var(--ink); }
  .contacts a { text-decoration: none; }
  .contacts__more { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 20px; font-family: var(--font-body) !important; font-size: 15px !important; }
  .contacts__social { display: flex; gap: 20px; }
  @media (max-width: 599px) { .contacts { grid-template-columns: 1fr 1fr; } .contacts > div:first-child { grid-column: 1 / -1; } }
</style>
